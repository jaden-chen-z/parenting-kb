# macOS
.DS_Store
._*

# Tier 3 用户合法购买的书 + 格式转换产出物不入仓(版权 + 体积),只追踪提取后的 notes/
10-sources/tier3-books/raw_pdfs/*.pdf
10-sources/tier3-books/raw_pdfs/*.epub
10-sources/tier3-books/raw_pdfs/*.azw3
10-sources/tier3-books/raw_pdfs/*.mobi
10-sources/tier3-books/raw_pdfs/*.md
10-sources/tier3-books/raw_pdfs/*.txt
10-sources/tier3-books/raw_pdfs/*.html
# OCR 后的分块中间产物不入仓(原书已屏蔽,chunks 是派生品,§10.1 工程步骤)
10-sources/tier3-books/raw_pdfs/*_chunks/

# Python venv (本项目 tooling)
.venv/
__pycache__/
*.pyc

# Tier 5 大体积音视频不入仓,只追踪转录/notes
10-sources/tier5-video-podcast/raw/*.mp4
10-sources/tier5-video-podcast/raw/*.mp3
10-sources/tier5-video-podcast/raw/*.wav
10-sources/tier5-video-podcast/raw/*.m4a

# 编辑器
.vscode/
.idea/
*.swp
*~

# 临时
*.tmp
*.bak
*.log

# 50-frontend/cards.json + glossary.json 是派生品,但 Cloudflare Pages 部署需要它们,
# 所以仍然追踪。每次改 yaml 后跑 build_cards_json.py + commit。

# 本地 admin_server.py 写的 per-user 进度 / 收藏(生产用 Cloudflare KV,这个文件只本地用)
50-frontend/state.json

# Node 依赖(npm install 重建)
node_modules/

# JSX 编译产物 — Cloudflare Pages build 时由 npm run build 重新生成
# (本地开发跑 `npm run build` 或 `npm run build:watch` 后才能在 admin_server.py 看效果)
50-frontend/admin.js
50-frontend/cards.js
50-frontend/folder-asset.js
50-frontend/folders.js
50-frontend/login.js
50-frontend/swipe-stack.js
50-frontend/tweaks-panel.js
